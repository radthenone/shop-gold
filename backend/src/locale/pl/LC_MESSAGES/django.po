msgid "This password must contain at least one digit."
msgstr "To hasło musi zawierać przynajmniej jedną cyfrę."

#: .\core\validators\password_validators.py:52
msgid "Your password must contain at least one digit."
msgstr "Twoje hasło musi zawierać przynajmniej jedną cyfrę."

#: .\core\validators\password_validators.py:67
msgid ""
"This password must contain at least one special character (e.g., @, $, !, %, "
"*, ?, &)."
msgstr ""
"To hasło musi zawierać przynajmniej jeden znak specjalny (np. @, $, !, %, "
"*, ?, &)."

#: .\core\validators\password_validators.py:75
msgid ""
"Your password must contain at least one special character from the set: @$!"
"%*?&"
msgstr ""
"Twoje hasło musi zawierać przynajmniej jeden znak specjalny z zestawu: @$!"
"%*?&"

#: .\templates\account\email\email_confirmation.html:7
#: .\templates\account\email\email_confirmation.html:17
#: .\templates\account\email\email_confirmation_signup.html:7
#: .\templates\account\email\email_confirmation_signup.html:17
msgid "Confirm Your Email Address"
msgstr "Potwierdź swój adres email"

#: .\templates\account\email\email_confirmation.html:20
#, python-format
msgid ""
"\n"
"            You are receiving this email because\n"
"            %(user_display)s requested to resend the verification code.\n"
"            "
msgstr ""
"\n"
"            Otrzymujesz ten email, ponieważ\n"
"            %(user_display)s poprosił o ponowne wysłanie kodu weryfikacyjnego.\n"
"            "

#: .\templates\account\email\email_confirmation.html:26
#: .\templates\account\email\email_confirmation_signup.html:26
msgid "Select your registration type:"
msgstr "Wybierz typ rejestracji:"

#: .\templates\account\email\email_confirmation.html:29
#: .\templates\account\email\email_confirmation_signup.html:29
msgid "QR code is:"
msgstr "Kod QR to:"

#: .\templates\account\email\email_confirmation.html:33
#: .\templates\account\email\email_confirmation_signup.html:33
msgid "Activation link is:"
msgstr "Link aktywacyjny to:"

#: .\templates\account\email\email_confirmation.html:35
#: .\templates\account\email\email_confirmation_signup.html:35
msgid ""
"Please enter this code in the application to complete the registration "
"process."
msgstr ""
"Wprowadź ten kod w aplikacji, aby zakończyć proces rejestracji."

#: .\templates\account\email\email_confirmation.html:36
#: .\templates\account\email\email_confirmation_signup.html:36
msgid "Code is available until 15 minutes:"
msgstr "Kod jest dostępny przez 15 minut:"

#: .\templates\account\email\email_confirmation.html:37
#: .\templates\account\email\email_confirmation_signup.html:37
msgid "If you did not request this email, you can safely ignore it."
msgstr "Jeśli nie prosiłeś o ten email, możesz go zignorować."

#: .\templates\account\email\email_confirmation.html:38
#: .\templates\account\email\email_confirmation_signup.html:38
msgid "Best regards,"
msgstr "Z poważaniem,"

#: .\templates\account\email\email_confirmation.html:38
#: .\templates\account\email\email_confirmation_signup.html:38
msgid "Your Application Team"
msgstr "Zespół Twojej Aplikacji"

#: .\templates\account\email\email_confirmation_signup.html:20
#, python-format
msgid ""
"\n"
"            You are receiving this email because %(user_display)s has given "
"your email address to register an account.\n"
"            "
msgstr ""
"\n"
"            Otrzymujesz ten email, ponieważ %(user_display)s podał "
"Twój adres email do rejestracji konta.\n"
"            "

#: .\templates\account\email\mfa_code.html:6
#: .\templates\account\email\mfa_code.html:41
msgid "Your Authentication Code"
msgstr "Twój kod uwierzytelniania"

#: .\templates\account\email\mfa_code.html:42
#: .\templates\account\email\mfa_registration.html:42
msgid "Hello"
msgstr "Witaj"

#: .\templates\account\email\mfa_code.html:43
msgid ""
"You requested a multi-factor authentication code. Please use the following "
"code to complete your authentication:"
msgstr ""
"Poprosiłeś o kod uwierzytelniania wieloczynnikowego. Użyj poniższego "
"kodu, aby zakończyć uwierzytelnianie:"

#: .\templates\account\email\mfa_code.html:47
#: .\templates\account\email\mfa_registration.html:47
msgid "This code will expire in 10 minutes."
msgstr "Ten kod wygaśnie za 10 minut."

#: .\templates\account\email\mfa_code.html:48
msgid ""
"If you did not request this code, please ignore this email and ensure your "
"account is secure."
msgstr ""
"Jeśli nie prosiłeś o ten kod, zignoruj ten email i upewnij się, że "
"Twoje konto jest bezpieczne."

#: .\templates\account\email\mfa_code.html:50
#: .\templates\account\email\mfa_registration.html:50
msgid "Thank you,"
msgstr "Dziękujemy,"

#: .\templates\account\email\mfa_code.html:51
#: .\templates\account\email\mfa_registration.html:51
msgid "The Shop Gold Team"
msgstr "Zespół Shop Gold"

#: .\templates\account\email\mfa_code.html:54
#: .\templates\account\email\mfa_registration.html:54
msgid "This email was sent to"
msgstr "Ten email został wysłany do"

#: .\templates\account\email\mfa_code.html:54
#: .\templates\account\email\mfa_registration.html:54
msgid "If you have questions or concerns, please contact our support team."
msgstr "Jeśli masz pytania lub wątpliwości, skontaktuj się z naszym zespołem wsparcia."

#: .\templates\account\email\mfa_registration.html:6
#: .\templates\account\email\mfa_registration.html:41
msgid "Complete Your Registration"
msgstr "Ukończ rejestrację"

#: .\templates\account\email\mfa_registration.html:43
msgid ""
"Thank you for registering with Shop Gold. To complete your registration, "
"please use the following verification code:"
msgstr ""
"Dziękujemy za rejestrację w Shop Gold. Aby ukończyć rejestrację, "
"użyj poniższego kodu weryfikacyjnego:"

#: .\templates\account\email\mfa_registration.html:48
msgid "If you did not register for an account, please ignore this email."
msgstr "Jeśli nie rejestrowałeś konta, zignoruj ten email."
