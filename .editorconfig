# EditorConfig is awesome: https://EditorConfig.org
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

[*.ts]
indent_style = space
indent_size = 2
max_line_length = 120

[*.html]
indent_style = space
indent_size = 2
max_line_length = 120

[*.{css,scss}]
indent_style = space
indent_size = 2
max_line_length = 120

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false
